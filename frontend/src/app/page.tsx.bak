"use client";

import {
  FormEvent,
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import Image from "next/image";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import {
  GoogleAuthProvider,
  onAuthStateChanged,
  sendPasswordResetEmail,
  signInWithEmailAndPassword,
  signInWithPopup,
  signOut,
  type User,
  createUserWithEmailAndPassword,
} from "firebase/auth";
import { firebaseAuth } from "@/lib/firebase-client";

/* ─────────────────────────── Types ─────────────────────────── */

type Source = { title: string; url: string };

type Message = {
  role: "user" | "assistant";
  text: string;
  confidence?: string;
  sources?: Source[];
  timestamp: number;
  streaming?: boolean;
};

type SessionSummary = {
  session_id: string;
  last_updated: string;
  message_count: number;
  preview: string;
};

type AuthTab = "signin" | "signup" | "forgot";

/* ─────────────────────────── Constants ─────────────────────────── */

const API = process.env.NEXT_PUBLIC_API_BASE ?? "http://localhost:8000";
const GREET =
  "Hi! I\u2019m Credon AI \u2014 your smart search assistant. Ask me anything in English or Hinglish.";

const SUGGESTIONS = [
  "What is quantum computing?",
  "Explain machine learning simply",
  "Latest technology trends 2026",
  "What is the capital of Japan?",
];

/* ─────────────────────────── Helpers ─────────────────────────── */

function fmtTime(ts: number): string {
  const d = new Date(ts);
  const h = d.getHours() % 12 || 12;
  const m = d.getMinutes().toString().padStart(2, "0");
  return `${h}:${m} ${d.getHours() >= 12 ? "PM" : "AM"}`;
}

function dateLabel(iso: string): string {
  const d = new Date(iso);
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const diff =
    today.getTime() -
    new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
  if (diff <= 0) return "Today";
  if (diff <= 86_400_000) return "Yesterday";
  if (diff <= 7 * 86_400_000) return "Previous 7 days";
  return "Older";
}

function cleanFirebaseError(msg: string): string {
  return msg
    .replace("Firebase: ", "")
    .replace(/\(auth\/.*?\)/g, "")
    .trim();
}

function newSessionId(): string {
  return `session-${Date.now()}`;
}

/* ══════════════════════════════════════════════════════════════════
   AUTH PAGE
   ══════════════════════════════════════════════════════════════════ */

function AuthPage({ onGuest }: { onGuest: () => void }) {
  const [tab, setTab] = useState<AuthTab>("signin");
  const [email, setEmail] = useState("");
  const [pw, setPw] = useState("");
  const [showPw, setShowPw] = useState(false);
  const [err, setErr] = useState("");
  const [ok, setOk] = useState("");
  const [busy, setBusy] = useState(false);

  const switchTab = (t: AuthTab) => {
    setTab(t);
    setErr("");
    setOk("");
  };

  const submit = async (e: FormEvent) => {
    e.preventDefault();
    if (!firebaseAuth) {
      setErr("Firebase not configured \u2014 create frontend/.env.local");
      return;
    }
    setBusy(true);
    setErr("");
    setOk("");
    try {
      if (tab === "forgot") {
        await sendPasswordResetEmail(firebaseAuth, email.trim());
        setOk("Reset link sent! Check your inbox.");
      } else if (tab === "signup") {
        if (pw.length < 6) {
          setErr("Password must be at least 6 characters");
          setBusy(false);
          return;
        }
        await createUserWithEmailAndPassword(firebaseAuth, email.trim(), pw);
      } else {
        await signInWithEmailAndPassword(firebaseAuth, email.trim(), pw);
      }
    } catch (x: unknown) {
      const msg = x instanceof Error ? x.message : "Something went wrong";
      setErr(cleanFirebaseError(msg));
    } finally {
      setBusy(false);
    }
  };

  const google = async () => {
    if (!firebaseAuth) {
      setErr("Firebase not configured");
      return;
    }
    setBusy(true);
    setErr("");
    try {
      await signInWithPopup(firebaseAuth, new GoogleAuthProvider());
    } catch (x: unknown) {
      const msg = x instanceof Error ? x.message : "Google sign-in failed";
      setErr(cleanFirebaseError(msg));
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-[#0a0a0a] px-4">
      <div className="w-full max-w-105">
        {/* Brand */}
        <div className="text-center mb-8">
          <div className="mx-auto w-16 h-16 rounded-2xl bg-linear-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-4 shadow-lg shadow-cyan-500/20">
            <Image src="/credon-logo.svg" alt="" width={36} height={36} />
          </div>
          <h1 className="text-3xl font-bold text-white tracking-tight">
            Credon AI
          </h1>
          <p className="text-zinc-400 mt-1 text-sm">
            Search smart. Learn fast.
          </p>
        </div>

        {/* Card */}
        <div className="rounded-2xl border border-zinc-800 bg-zinc-900/70 backdrop-blur-xl p-6 shadow-2xl">
          {tab !== "forgot" ? (
            <div className="flex mb-6 bg-zinc-800/60 rounded-xl p-1">
              {(["signin", "signup"] as AuthTab[]).map((t) => (
                <button
                  key={t}
                  type="button"
                  onClick={() => switchTab(t)}
                  className={`flex-1 py-2.5 text-sm rounded-lg font-medium transition-all ${
                    tab === t
                      ? "bg-zinc-700 text-white shadow"
                      : "text-zinc-400 hover:text-zinc-200"
                  }`}
                >
                  {t === "signin" ? "Sign In" : "Create Account"}
                </button>
              ))}
            </div>
          ) : (
            <div className="mb-6">
              <h2 className="text-lg font-semibold text-white">
                Reset Password
              </h2>
              <p className="text-sm text-zinc-400 mt-1">
                We&apos;ll email you a reset link
              </p>
            </div>
          )}

          <form onSubmit={submit} className="space-y-4">
            {/* Email */}
            <div>
              <label className="block text-sm text-zinc-400 mb-1.5">
                Email address
              </label>
              <input
                type="email"
                required
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="you@example.com"
                className="w-full rounded-xl border border-zinc-700 bg-zinc-800/50 px-4 py-3 text-white placeholder:text-zinc-500 outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/20 transition"
              />
            </div>

            {/* Password */}
            {tab !== "forgot" && (
              <div>
                <label className="block text-sm text-zinc-400 mb-1.5">
                  Password
                </label>
                <div className="relative">
                  <input
                    type={showPw ? "text" : "password"}
                    required
                    minLength={6}
                    value={pw}
                    onChange={(e) => setPw(e.target.value)}
                    placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;"
                    className="w-full rounded-xl border border-zinc-700 bg-zinc-800/50 px-4 py-3 pr-11 text-white placeholder:text-zinc-500 outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/20 transition"
                  />
                  <button
                    type="button"
                    onClick={() => setShowPw(!showPw)}
                    className="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 transition"
                    tabIndex={-1}
                  >
                    {showPw ? (
                      <svg
                        className="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        strokeWidth={1.5}
                      >
                        <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                      </svg>
                    ) : (
                      <svg
                        className="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        strokeWidth={1.5}
                      >
                        <path d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    )}
                  </button>
                </div>
              </div>
            )}

            {/* Forgot password link */}
            {tab === "signin" && (
              <button
                type="button"
                onClick={() => switchTab("forgot")}
                className="text-sm text-cyan-400 hover:text-cyan-300 transition"
              >
                Forgot password?
              </button>
            )}

            {/* Error / Success */}
            {err && (
              <p className="text-sm text-rose-400 bg-rose-500/10 border border-rose-500/20 rounded-lg px-3 py-2">
                {err}
              </p>
            )}
            {ok && (
              <p className="text-sm text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-3 py-2">
                {ok}
              </p>
            )}

            {/* Submit */}
            <button
              type="submit"
              disabled={busy}
              className="w-full py-3 rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 text-white font-semibold hover:brightness-110 disabled:opacity-50 transition shadow-lg shadow-cyan-500/20"
            >
              {busy
                ? "Please wait\u2026"
                : tab === "signin"
                  ? "Sign In"
                  : tab === "signup"
                    ? "Create Account"
                    : "Send Reset Link"}
            </button>
          </form>

          {/* Back to sign in (from forgot) */}
          {tab === "forgot" ? (
            <button
              type="button"
              onClick={() => switchTab("signin")}
              className="mt-4 w-full text-center text-sm text-zinc-400 hover:text-white transition"
            >
              &larr; Back to Sign In
            </button>
          ) : (
            <>
              {/* Divider */}
              <div className="flex items-center gap-3 my-5">
                <span className="flex-1 h-px bg-zinc-800" />
                <span className="text-xs text-zinc-500 uppercase tracking-wide">
                  or
                </span>
                <span className="flex-1 h-px bg-zinc-800" />
              </div>

              {/* Google */}
              <button
                type="button"
                onClick={google}
                disabled={busy}
                className="w-full flex items-center justify-center gap-3 py-3 rounded-xl border border-zinc-700 bg-zinc-800/40 text-white hover:bg-zinc-800 transition disabled:opacity-50"
              >
                <svg className="w-5 h-5" viewBox="0 0 24 24">
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
                Continue with Google
              </button>
            </>
          )}
        </div>

        {/* Guest mode */}
        <button
          type="button"
          onClick={onGuest}
          className="mt-5 w-full text-center text-sm text-zinc-500 hover:text-zinc-300 transition"
        >
          Continue without an account &rarr;
        </button>
      </div>
    </div>
  );
}

/* ══════════════════════════════════════════════════════════════════
   CHAT PAGE
   ══════════════════════════════════════════════════════════════════ */

function ChatPage({
  user,
  onSignOut,
  isGuest,
}: {
  user: User | null;
  onSignOut: () => void;
  isGuest: boolean;
}) {
  const [query, setQuery] = useState("");
  const [messages, setMessages] = useState<Message[]>([
    { role: "assistant", text: GREET, timestamp: Date.now() },
  ]);
  const [loading, setLoading] = useState(false);
  const [sessions, setSessions] = useState<SessionSummary[]>([]);
  const [currentSession, setCurrentSession] = useState("");
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [copied, setCopied] = useState<number | null>(null);
  const bottomRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);

  const [localUserId] = useState(() => {
    if (typeof window === "undefined") return "guest";
    const stored = localStorage.getItem("credon-local-uid");
    if (stored) return stored;
    const id = `guest-${crypto.randomUUID().slice(0, 8)}`;
    localStorage.setItem("credon-local-uid", id);
    return id;
  });

  const uid = user?.uid ?? localUserId;
  const sessionStorageKey = `credon-active-session:${uid}`;
  const displayName =
    user?.displayName ?? user?.email?.split("@")[0] ?? "Guest";

  const isEmptyChat = messages.length === 1 && messages[0].text === GREET;

  /* Auto-scroll */
  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, loading]);

  /* Load sessions list */
  const loadSessions = useCallback(async () => {
    try {
      const r = await fetch(`${API}/api/v1/chats/${uid}`);
      if (!r.ok) return;

      const data: SessionSummary[] = await r.json();
      setSessions(data);

      setCurrentSession((prev) => {
        const hasPrev = prev
          ? data.some((session) => session.session_id === prev)
          : false;
        if (hasPrev) return prev;

        if (typeof window !== "undefined") {
          const stored = localStorage.getItem(sessionStorageKey);
          if (stored && data.some((session) => session.session_id === stored)) {
            return stored;
          }
        }

        if (data.length > 0) return data[0].session_id;
        return prev || newSessionId();
      });
    } catch {
      /* ignore */
    }
  }, [uid, sessionStorageKey]);

  useEffect(() => {
    void loadSessions();
  }, [loadSessions]);

  useEffect(() => {
    if (!currentSession) {
      if (typeof window !== "undefined") {
        const stored = localStorage.getItem(sessionStorageKey);
        if (stored) {
          setCurrentSession(stored);
          return;
        }
      }
      setCurrentSession(newSessionId());
      return;
    }

    if (typeof window !== "undefined") {
      localStorage.setItem(sessionStorageKey, currentSession);
    }
  }, [currentSession, sessionStorageKey]);

  /* Load transcript when switching sessions */
  useEffect(() => {
    if (!currentSession) return;

    const load = async () => {
      try {
        const r = await fetch(`${API}/api/v1/chats/${uid}/${currentSession}`);
        if (!r.ok) {
          setMessages([
            { role: "assistant", text: GREET, timestamp: Date.now() },
          ]);
          return;
        }
        const data = await r.json();
        if (!data.messages?.length) {
          setMessages([
            { role: "assistant", text: GREET, timestamp: Date.now() },
          ]);
          return;
        }
        setMessages(
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          data.messages.map((m: any) => ({
            role: m.role,
            text: m.text,
            timestamp: m.created_at
              ? new Date(m.created_at).getTime()
              : Date.now(),
          }))
        );
      } catch {
        setMessages([
          { role: "assistant", text: GREET, timestamp: Date.now() },
        ]);
      }
    };
    void load();
  }, [uid, currentSession]);

  /* New chat */
  const newChat = () => {
    setCurrentSession(newSessionId());
    setMessages([{ role: "assistant", text: GREET, timestamp: Date.now() }]);
    setSidebarOpen(false);
    inputRef.current?.focus();
  };

  /* Send message — uses SSE streaming for real-time token delivery */
  const send = async (text: string) => {
    const q = text.trim();
    if (!q || loading) return;

    const userMsg: Message = { role: "user", text: q, timestamp: Date.now() };
    setMessages((prev) => [...prev, userMsg]);
    setQuery("");
    setLoading(true);

    try {
      const r = await fetch(`${API}/api/v1/chat/stream`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user_id: uid,
          session_id: currentSession,
          query: q,
          language: "auto",
        }),
      });

      if (!r.ok || !r.body) throw new Error("Stream failed");

      // Add placeholder streaming message
      const assistantIdx = { current: -1 };
      setMessages((prev) => {
        assistantIdx.current = prev.length;
        return [
          ...prev,
          { role: "assistant", text: "", timestamp: Date.now(), streaming: true },
        ];
      });

      const reader = r.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let accSources: Source[] = [];
      let accConfidence: string | undefined;

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        const lines = buffer.split("\n");
        buffer = lines.pop() ?? "";

        for (const line of lines) {
          if (!line.startsWith("data: ")) continue;
          try {
            const evt = JSON.parse(line.slice(6));
            if (evt.type === "sources") {
              accSources = (evt.sources ?? []).filter(
                (s: Source) => s.url && !s.url.startsWith("about:")
              );
              accConfidence = evt.confidence;
            } else if (evt.type === "token") {
              setMessages((prev) => {
                const idx = assistantIdx.current;
                if (idx < 0 || idx >= prev.length) return prev;
                const updated = [...prev];
                updated[idx] = {
                  ...updated[idx],
                  text: updated[idx].text + evt.content,
                };
                return updated;
              });
            } else if (evt.type === "done") {
              setMessages((prev) => {
                const idx = assistantIdx.current;
                if (idx < 0 || idx >= prev.length) return prev;
                const updated = [...prev];
                updated[idx] = {
                  ...updated[idx],
                  streaming: false,
                  sources: accSources.length ? accSources : undefined,
                  confidence: accConfidence,
                };
                return updated;
              });
            }
          } catch { /* skip bad JSON */ }
        }
      }

      // Finalize if done event was missed
      setMessages((prev) => {
        const idx = assistantIdx.current;
        if (idx < 0 || idx >= prev.length) return prev;
        const updated = [...prev];
        if (updated[idx].streaming) {
          updated[idx] = { ...updated[idx], streaming: false, sources: accSources.length ? accSources : undefined, confidence: accConfidence };
        }
        return updated;
      });

      void loadSessions();
    } catch {
      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          text: "Something went wrong. Please check if the backend is running and try again.",
          confidence: "low",
          timestamp: Date.now(),
        },
      ]);
    } finally {
      setLoading(false);
      inputRef.current?.focus();
    }
  };

  const onSubmit = async (e: FormEvent) => {
    e.preventDefault();
    await send(query);
  };

  /* Copy message text */
  const copyText = (index: number, text: string) => {
    navigator.clipboard.writeText(text);
    setCopied(index);
    setTimeout(() => setCopied(null), 2000);
  };

  /* Group sessions by date */
  const grouped = useMemo(() => {
    const g: Record<string, SessionSummary[]> = {};
    for (const s of sessions) {
      const label = dateLabel(s.last_updated);
      (g[label] ??= []).push(s);
    }
    return g;
  }, [sessions]);

  return (
    <div className="h-screen flex bg-[#0a0a0a] text-white overflow-hidden">
      {/* Mobile overlay */}
      {sidebarOpen && (
        <div
          className="fixed inset-0 bg-black/60 z-30 lg:hidden"
          onClick={() => setSidebarOpen(false)}
        />
      )}

      {/* ─── Sidebar ─── */}
      <aside
        className={`fixed lg:static inset-y-0 left-0 z-40 w-70 bg-[#111111] border-r border-zinc-800/60 flex flex-col transition-transform duration-200 lg:translate-x-0 ${
          sidebarOpen ? "translate-x-0" : "-translate-x-full"
        }`}
      >
        {/* New chat button */}
        <div className="p-3">
          <button
            type="button"
            onClick={newChat}
            className="w-full flex items-center gap-2 rounded-xl border border-zinc-700/60 bg-zinc-800/40 px-4 py-3 text-sm hover:bg-zinc-800 transition"
          >
            <svg
              className="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              strokeWidth={2}
            >
              <path strokeLinecap="round" d="M12 4v16m8-8H4" />
            </svg>
            New chat
          </button>
        </div>

        {/* Sessions list */}
        <nav className="flex-1 overflow-y-auto px-3 pb-3 space-y-4">
          {Object.entries(grouped).map(([label, items]) =>
            items.length === 0 ? null : (
              <div key={label}>
                <p className="text-[11px] font-medium text-zinc-500 uppercase tracking-wider px-2 mb-1.5">
                  {label}
                </p>
                <div className="space-y-0.5">
                  {items.map((s) => (
                    <button
                      key={s.session_id}
                      type="button"
                      onClick={() => {
                        setCurrentSession(s.session_id);
                        setSidebarOpen(false);
                      }}
                      className={`w-full text-left rounded-lg px-3 py-2.5 text-sm transition ${
                        currentSession === s.session_id
                          ? "bg-zinc-800 text-white"
                          : "text-zinc-400 hover:bg-zinc-800/50 hover:text-zinc-200"
                      }`}
                    >
                      <p className="truncate">
                        {s.preview || "New conversation"}
                      </p>
                    </button>
                  ))}
                </div>
              </div>
            )
          )}
          {sessions.length === 0 && (
            <p className="text-xs text-zinc-600 text-center mt-8">
              No conversations yet
            </p>
          )}
        </nav>

        {/* User info */}
        <div className="p-3 border-t border-zinc-800/60">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-full bg-linear-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-xs font-bold shrink-0">
              {displayName[0]?.toUpperCase() ?? "G"}
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-sm text-white truncate">{displayName}</p>
              <p className="text-[11px] text-zinc-500">
                {isGuest ? "Guest mode" : "Signed in"}
              </p>
            </div>
            <button
              type="button"
              onClick={onSignOut}
              title={isGuest ? "Back to login" : "Sign out"}
              className="text-zinc-500 hover:text-white transition p-1.5 rounded-lg hover:bg-zinc-800"
            >
              <svg
                className="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                strokeWidth={2}
              >
                <path
                  strokeLinecap="round"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h5a2 2 0 012 2v1"
                />
              </svg>
            </button>
          </div>
        </div>
      </aside>

      {/* ─── Main Area ─── */}
      <main className="flex-1 flex flex-col min-w-0">
        {/* Top bar */}
        <header className="h-14 border-b border-zinc-800/40 flex items-center px-4 gap-3 shrink-0 bg-[#0a0a0a]/80 backdrop-blur-sm">
          <button
            type="button"
            onClick={() => setSidebarOpen(true)}
            className="lg:hidden text-zinc-400 hover:text-white transition"
            title="Open sidebar"
          >
            <svg
              className="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              strokeWidth={2}
            >
              <path
                strokeLinecap="round"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </button>
          <Image
            src="/credon-logo.svg"
            alt=""
            width={26}
            height={26}
            className="hidden sm:block"
          />
          <span className="font-semibold tracking-tight">Credon AI</span>
        </header>

        {/* Messages / Welcome */}
        <div className="flex-1 overflow-y-auto">
          {isEmptyChat ? (
            /* ─── Welcome state ─── */
            <div className="h-full flex flex-col items-center justify-center px-4 -mt-10">
              <div className="w-14 h-14 rounded-2xl bg-linear-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-5 shadow-lg shadow-cyan-500/15">
                <Image src="/credon-logo.svg" alt="" width={32} height={32} />
              </div>
              <h2 className="text-2xl font-semibold text-white mb-2">
                How can I help you today?
              </h2>
              <p className="text-zinc-400 text-sm mb-8 text-center max-w-md">
                Ask anything in English or Hinglish. I search the web and give
                you grounded answers.
              </p>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-lg">
                {SUGGESTIONS.map((s) => (
                  <button
                    key={s}
                    type="button"
                    onClick={() => send(s)}
                    className="text-left rounded-xl border border-zinc-800 bg-zinc-900/60 px-4 py-3.5 text-sm text-zinc-300 hover:bg-zinc-800/80 hover:text-white hover:border-zinc-700 transition"
                  >
                    {s}
                  </button>
                ))}
              </div>
            </div>
          ) : (
            /* ─── Messages list ─── */
            <div className="max-w-3xl mx-auto px-4 py-6 space-y-5">
              {messages.map((m, i) => (
                <div
                  key={i}
                  className={`flex gap-3 ${
                    m.role === "user" ? "flex-row-reverse" : ""
                  }`}
                >
                  {/* Avatar */}
                  <div
                    className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-[11px] font-bold ${
                      m.role === "assistant"
                        ? "bg-linear-to-br from-cyan-500 to-blue-600"
                        : "bg-zinc-700"
                    }`}
                  >
                    {m.role === "assistant"
                      ? "C"
                      : displayName[0]?.toUpperCase() ?? "U"}
                  </div>

                  {/* Content */}
                  <div
                    className={`flex flex-col max-w-[80%] ${
                      m.role === "user" ? "items-end" : "items-start"
                    }`}
                  >
                    {/* Bubble */}
                    <div
                      className={`rounded-2xl px-4 py-3 ${
                        m.role === "user"
                          ? "bg-cyan-600/90 text-white rounded-tr-md"
                          : "bg-zinc-800/80 border border-zinc-700/40 rounded-tl-md"
                      }`}
                    >
                      {m.role === "assistant" && m.text !== GREET ? (
                        <div className="prose prose-invert prose-sm max-w-none text-[15px] leading-relaxed [&_pre]:bg-zinc-900 [&_pre]:border [&_pre]:border-zinc-700/40 [&_pre]:rounded-xl [&_pre]:p-3 [&_code]:text-cyan-300 [&_code]:text-[13px] [&_a]:text-cyan-400 [&_a]:underline [&_a]:underline-offset-2 [&_h1]:text-lg [&_h2]:text-base [&_h3]:text-sm [&_h1]:font-bold [&_h2]:font-semibold [&_ul]:list-disc [&_ul]:pl-4 [&_ol]:list-decimal [&_ol]:pl-4 [&_p]:my-1.5 [&_li]:my-0.5 [&_blockquote]:border-l-2 [&_blockquote]:border-cyan-500/40 [&_blockquote]:pl-3 [&_blockquote]:italic [&_blockquote]:text-zinc-400">
                          <ReactMarkdown remarkPlugins={[remarkGfm]}>
                            {m.text || (m.streaming ? "\u200B" : "")}
                          </ReactMarkdown>
                          {m.streaming && (
                            <span className="inline-block w-2 h-4 bg-cyan-400 animate-pulse rounded-sm ml-0.5 align-text-bottom" />
                          )}
                        </div>
                      ) : (
                        <p className="whitespace-pre-wrap text-[15px] leading-relaxed">
                          {m.text}
                        </p>
                      )}
                    </div>

                    {/* Sources (compact pills) */}
                    {m.role === "assistant" &&
                      m.sources &&
                      m.sources.length > 0 && (
                        <div className="mt-2 flex flex-wrap gap-1.5">
                          {m.sources.map((s, si) => (
                            <a
                              key={si}
                              href={s.url}
                              target="_blank"
                              rel="noreferrer"
                              className="inline-flex items-center gap-1 text-[11px] bg-zinc-800/60 border border-zinc-700/30 rounded-full px-2.5 py-1 text-cyan-400 hover:text-cyan-300 hover:bg-zinc-800 transition"
                            >
                              <svg
                                className="w-3 h-3"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                strokeWidth={2}
                              >
                                <path
                                  strokeLinecap="round"
                                  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"
                                />
                                <path
                                  strokeLinecap="round"
                                  d="M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.102 1.101"
                                />
                              </svg>
                              {s.title.length > 35
                                ? s.title.slice(0, 35) + "\u2026"
                                : s.title}
                            </a>
                          ))}
                        </div>
                      )}

                    {/* Low confidence disclaimer only */}
                    {m.role === "assistant" &&
                      m.confidence === "low" &&
                      m.text !== GREET && (
                        <p className="mt-1.5 text-[11px] text-zinc-500 flex items-center gap-1">
                          <svg
                            className="w-3 h-3"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            strokeWidth={2}
                          >
                            <path
                              strokeLinecap="round"
                              d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                          </svg>
                          This information may not be fully accurate
                        </p>
                      )}

                    {/* Timestamp + Copy */}
                    <div
                      className={`flex items-center gap-2 mt-1 ${
                        m.role === "user" ? "flex-row-reverse" : ""
                      }`}
                    >
                      <span className="text-[11px] text-zinc-600">
                        {fmtTime(m.timestamp)}
                      </span>
                      {m.role === "assistant" && m.text !== GREET && (
                        <button
                          type="button"
                          onClick={() => copyText(i, m.text)}
                          className="text-zinc-600 hover:text-zinc-300 transition p-0.5"
                          title="Copy"
                        >
                          {copied === i ? (
                            <svg
                              className="w-3.5 h-3.5 text-emerald-400"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              strokeWidth={2}
                            >
                              <path
                                strokeLinecap="round"
                                d="M5 13l4 4L19 7"
                              />
                            </svg>
                          ) : (
                            <svg
                              className="w-3.5 h-3.5"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              strokeWidth={2}
                            >
                              <path
                                strokeLinecap="round"
                                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                              />
                            </svg>
                          )}
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              ))}

              {/* Thinking / Searching animation */}
              {loading && !messages.some((m) => m.streaming) && (
                <div className="flex gap-3">
                  <div className="w-8 h-8 rounded-full bg-linear-to-br from-cyan-500 to-blue-600 flex items-center justify-center shrink-0 text-[11px] font-bold">
                    C
                  </div>
                  <div className="bg-zinc-800/80 border border-zinc-700/40 rounded-2xl rounded-tl-md px-5 py-4">
                    <div className="flex items-center gap-2">
                      <div className="flex items-center gap-1.5">
                        <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce [animation-delay:0ms]" />
                        <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce [animation-delay:150ms]" />
                        <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce [animation-delay:300ms]" />
                      </div>
                      <span className="text-xs text-zinc-500 ml-1">Searching the web&hellip;</span>
                    </div>
                  </div>
                </div>
              )}

              <div ref={bottomRef} />
            </div>
          )}
        </div>

        {/* ─── Input ─── */}
        <div className="border-t border-zinc-800/40 p-4 bg-[#0a0a0a]/80 backdrop-blur-sm">
          <form onSubmit={onSubmit} className="max-w-3xl mx-auto">
            <div className="flex gap-2 items-end bg-zinc-900/80 border border-zinc-700/60 rounded-2xl px-4 py-2 focus-within:border-cyan-500/40 transition shadow-lg shadow-black/20">
              <input
                ref={inputRef}
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Message Credon AI&#8230;"
                className="flex-1 bg-transparent py-2.5 outline-none text-[15px] placeholder:text-zinc-500"
              />
              <button
                type="submit"
                disabled={!query.trim() || loading}
                className="w-9 h-9 rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 flex items-center justify-center disabled:opacity-30 transition hover:brightness-110 shrink-0 mb-0.5"
                title="Send message"
              >
                <svg
                  className="w-4 h-4 text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  strokeWidth={2.5}
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
                  />
                </svg>
              </button>
            </div>
            <p className="text-center text-[11px] text-zinc-600 mt-2">
              Credon AI can make mistakes. Verify important information.
            </p>
          </form>
        </div>
      </main>
    </div>
  );
}

/* ══════════════════════════════════════════════════════════════════
   ROOT
   ══════════════════════════════════════════════════════════════════ */

export default function Home() {
  const [user, setUser] = useState<User | null>(null);
  const [checked, setChecked] = useState(false);
  const [guest, setGuest] = useState(false);

  useEffect(() => {
    if (!firebaseAuth) {
      const t = setTimeout(() => setChecked(true), 0);
      return () => clearTimeout(t);
    }
    return onAuthStateChanged(firebaseAuth, (u) => {
      setUser(u);
      setChecked(true);
    });
  }, []);

  if (!checked)
    return (
      <div className="min-h-screen flex items-center justify-center bg-[#0a0a0a]">
        <div className="flex items-center gap-2 text-zinc-400">
          <div className="w-5 h-5 border-2 border-zinc-600 border-t-cyan-500 rounded-full animate-spin" />
          Loading&hellip;
        </div>
      </div>
    );

  if (!user && !guest) return <AuthPage onGuest={() => setGuest(true)} />;

  return (
    <ChatPage
      user={user}
      isGuest={!user}
      onSignOut={async () => {
        if (firebaseAuth) await signOut(firebaseAuth);
        setGuest(false);
      }}
    />
  );
}
