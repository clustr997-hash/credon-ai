# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Optional local model (for developer testing only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional DeepSeek cloud model
# Create key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional override, defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Feature flags
USE_LOCAL_MODEL=true
USE_WEB_SEARCH=true
