# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Optional local model (for developer testing only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Model runtime mode: auto | cloud | local
MODEL_RUNTIME_MODE=auto
# Optional global toggle
USE_MODEL_GENERATION=true

# Optional DeepSeek cloud model
# Create key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional override, defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# Optional Groq fallback model
# Create key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional multi-search providers
SERPER_API_KEY=
LANGSEARCH_API_KEY=
# Optional override if your LangSearch endpoint differs
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1/web-search

# Knowledge store backend: auto | postgres | firestore | local
KNOWLEDGE_STORE_BACKEND=auto
# Supabase pooled Postgres URL (pgvector enabled)
SUPABASE_DB_URL=

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Feature flags
USE_LOCAL_MODEL=true
USE_WEB_SEARCH=true
ENABLE_PAGE_EXTRACTION=false
